# .env.example — copy to .env (gitignored) and fill in. NEVER commit real values.
# The model layer (src/providers.py) reads these via load_env().

# LAN Ollama server (RTX 5090). Private IP, LAN-only. Do NOT hardcode elsewhere.
OLLAMA_BASE_URL=

# API providers (only fill the ones you use; keys from your own accounts).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
